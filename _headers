# =============================================
# _headers — Cloudflare Pages HTTP Headers
# =============================================
# Place this file in the ROOT of your repository.
# Cloudflare Pages reads it automatically on every deploy.
#
# Documentation: https://developers.cloudflare.com/pages/platform/headers/
#
# HOW IT WORKS:
#   Each block starts with a URL pattern, followed by header definitions.
#   Patterns support wildcards (*).
# =============================================

# ------------------------------------------
# SECURITY HEADERS — Applied to all pages
# These protect visitors from common attacks.
# ------------------------------------------
/*
  # Prevents browsers from guessing file types (XSS protection)
  X-Content-Type-Options: nosniff

  # Prevents your site from being embedded in iframes on other sites (clickjacking)
  X-Frame-Options: SAMEORIGIN

  # Forces HTTPS for 1 year — never serve over HTTP
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Controls how much referrer info is shared when clicking external links
  Referrer-Policy: strict-origin-when-cross-origin

  # Enables browser's built-in XSS filter
  X-XSS-Protection: 1; mode=block

  # Permissions Policy — disable features you don't use (privacy best practice)
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# ------------------------------------------
# CACHE HEADERS — Static assets (1 year)
# These files never change between deploys
# (filenames should include a hash for cache-busting)
# ------------------------------------------
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=86400

/js/*
  Cache-Control: public, max-age=86400

# ------------------------------------------
# DATA FILES — Cache for 5 minutes
# Blog posts JSON files update frequently
# ------------------------------------------
/data/*
  Cache-Control: public, max-age=300

# ------------------------------------------
# HTML PAGES — Do not cache
# Always serve fresh HTML so updates are instant
# ------------------------------------------
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate
